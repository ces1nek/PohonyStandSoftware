###############################################################################
# STM32CubeIDE / Eclipse workspace
###############################################################################

# Workspace metadata - defaultne ignorovat vse
.metadata/*

# Povolit vybrane preference Eclipse
!.metadata/.plugins/
.metadata/.plugins/*
!.metadata/.plugins/org.eclipse.core.runtime/
.metadata/.plugins/org.eclipse.core.runtime/*
!.metadata/.plugins/org.eclipse.core.runtime/.settings/
.metadata/.plugins/org.eclipse.core.runtime/.settings/*

# Sem pridavat pouze konkretni preference, ktere chceme verzovat
# Priklady - podle skutecneho obsahu workspace:
!.metadata/.plugins/org.eclipse.core.runtime/.settings/org.eclipse.ui.prefs
!.metadata/.plugins/org.eclipse.core.runtime/.settings/org.eclipse.core.resources.prefs

###############################################################################
# Eclipse temporary files and history
###############################################################################

# Local history and editor state
.history/
.localhistory/
*.bak
*.tmp
*.swp
*.swo
*~

###############################################################################
# Build outputs
###############################################################################

**/Debug/
**/Release/
**/build/
**/Build/
**/Binaries/
**/Objects/

*.o
*.d
*.elf
*.hex
*.bin
*.map
*.list
*.cyclo
*.su

###############################################################################
# Eclipse / STM32CubeIDE local files
###############################################################################

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.log
*.temp
*.orig
*.rej

